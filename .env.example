# Copy to `.env` (gitignored) and set a real password.
# The password is embedded in DATABASE_URL, so avoid URL-special characters
# (@ : / ? # %) or percent-encode them.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker

# Backups (optional; defaults shown). Dumps go to ./backups.
# BACKUP_UID/GID should match your host user so you own the dump files (`id -u`, `id -g`).
# BACKUP_UID=1000
# BACKUP_GID=1000
# BACKUP_KEEP=14
# BACKUP_TIME=03:00
# BACKUP_TZ=UTC
