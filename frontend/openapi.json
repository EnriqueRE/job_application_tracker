        "title": "ApplicationEventType",
        "type": "string"
      },
      "ApplicationEventUpdate": {
        "description": "Fields to change on an Application Event; omitted fields stay as they are.\n\nChanging ``event_type`` without a ``resulting_status`` re-derives the resulting\nstatus from the new type.",
