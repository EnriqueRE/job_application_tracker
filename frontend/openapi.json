          "saved",
          "applied",
          "screening",
          "interview",
          "technical_interview",
          "final_interview",
          "offer",
          "rejected",
          "withdrawn",
          "closed",
          "no_response"
        ],
        "title": "ApplicationStatus",
        "type": "string"
      },
      "ApplicationStatusRead": {
        "description": "An Application's Pipeline Status after a timeline or Status Override change.",
        "properties": {
