      "ApplicationEventType": {
        "description": "Kinds of Application Event in an Application's timeline.",
        "enum": [
          "saved",
          "applied",
          "contacted",
          "screening",
          "interview_scheduled",
          "interview_completed",
          "technical_interview",
          "final_interview",
          "follow_up",
          "offer",
          "rejected",
          "withdrawn",
          "closed",
          "no_response",
          "note"
