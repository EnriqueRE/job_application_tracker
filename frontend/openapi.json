  "info": {
    "title": "Job Application Tracker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/applications": {
      "get": {
        "operationId": "list_applications_api_applications_get",
        "parameters": [
          {
            "description": "Case-insensitive substring of the Organization name",
            "in": "query",
            "name": "organization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring of the Organization name",
              "title": "Organization"
            }
          },
          {
            "description": "Case-insensitive substring of the role",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring of the role",
              "title": "Role"
            }
          },
          {
            "description": "Keep Applications in any of these Pipeline Statuses",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/ApplicationStatus"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Keep Applications in any of these Pipeline Statuses",
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Archived",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ApplicationSort",
              "default": "applied_at"
            }
          },
          {
            "description": "Applications without the sort date come last either way",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "default": "desc",
              "description": "Applications without the sort date come last either way"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApplicationRead"
                  },
                  "title": "Response List Applications Api Applications Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Applications",
        "tags": [
          "applications"
        ]
      },
      "post": {
        "operationId": "create_application_api_applications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Application",
        "tags": [
          "applications"
        ]
      }
    },
    "/api/applications/due": {
      "get": {
        "description": "Non-archived Applications whose next action date is overdue or within the next\n7 days, soonest first.",
        "operationId": "due_applications_api_applications_due_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApplicationRead"
                  },
                  "title": "Response Due Applications Api Applications Due Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Due Applications",
        "tags": [
          "applications"
        ]
      }
    },
    "/api/applications/status-counts": {
      "get": {
        "description": "A count for every Pipeline Status (in pipeline order) over non-archived Applications.",
        "operationId": "status_counts_api_applications_status_counts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StatusCount"
                  },
                  "title": "Response Status Counts Api Applications Status Counts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status Counts",
        "tags": [
          "applications"
        ]
      }
    },
    "/api/applications/{application_id}": {
      "get": {
        "operationId": "get_application_api_applications__application_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "application_id",
            "required": true,
            "schema": {
              "title": "Application Id",
              "type": "integer"
            }
